          "name": "Get a campaign",
          "request": {
            "url": { "raw": "{{appUrl}}/v1/campaigns/:campaign_id", "host": ["{{appUrl}}"], "path": ["v1", "campaigns", ":campaign_id"], "variable": [{ "key": "campaign_id", "value": "1" }] },
            "header": [],
            "method": "GET",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{appApiKey}}" }] }
          },
          "response": []
